# Copy to .env and fill in from Supabase → Settings → API.
# NOTE: the app currently hard-codes the project in src/lib/supabase.ts and does not
# read these; see scripts/README_SYNC.md for the project-ref mismatch.
SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# Only needed by scripts/sync_supabase.py. Prefer `supabase login` instead, which
# lets the script fetch the key at runtime rather than storing it in a file.
# SUPABASE_SERVICE_KEY=
