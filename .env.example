# Supabase — set these in Netlify UI under Site > Environment variables
# The app has fallback credentials embedded, but you should override them
# with your own project's keys for production.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Anthropic — server-only, used by the Add Transaction screenshot parser
# (src/lib/api/transactions.functions.ts). Never prefix this with VITE_ —
# it must stay out of the client bundle. Set in Netlify UI under
# Site > Environment variables.
ANTHROPIC_API_KEY=sk-ant-your-key-here
